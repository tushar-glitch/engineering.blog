DATABASE_URL=postgres://blogify:blogify@localhost:5440/blogify

# Keys for `npm run tag` (runs every model in tag.mjs in parallel). Missing keys just skip that worker.
NVIDIA_API_KEY=
GROQ_API_KEY=

# Single-model settings below are only used by `npm run enrich` and search.

# Any OpenAI-compatible chat API. Pick one block.

# Groq (free tier, open models): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# NVIDIA (free, 40 req/min, best quality we tested): https://build.nvidia.com
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=z-ai/glm-5.3-flash
# LLM_API_KEY=nvapi-...
# LLM_CONCURRENCY=4
# LLM_TIMEOUT_SECS=180

# xAI Grok: https://console.x.ai
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4-fast
# LLM_API_KEY=

# Lower these if you hit tokens-per-minute limits on a free tier.
MAX_INPUT_CHARS=12000
LLM_CONCURRENCY=1

# Password for /admin (any username)
ADMIN_TOKEN=
