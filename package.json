{
  "name": "blogify",
  "private": true,
  "type": "module",
  "scripts": {
    "db": "docker compose up -d",
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "fetch": "node --env-file-if-exists=.env fetch.mjs",
    "enrich": "node --env-file-if-exists=.env enrich.mjs",
    "tag": "node --env-file-if-exists=.env tag.mjs",
    "search": "node --env-file-if-exists=.env search.mjs",
    "test": "node test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "fast-xml-parser": "^5.11.2",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
